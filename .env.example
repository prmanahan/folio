# Personal Site - Environment Variables
# Copy to .env and fill in real values

# Server
PORT=3000

# Database
DATABASE_URL=data/site.db

# Admin dashboard (used by both cargo run and docker compose)
ADMIN_PASSWORD=changeme

# CORS origin — set to your production domain in production (e.g. https://peter.manahan.io)
# Must be set via fly.toml [env] for production deploys
CORS_ORIGIN=http://localhost:3000

# AI features (optional - chat and job fit analysis)
ANTHROPIC_API_KEY=

# Origin lock — shared secret the reverse proxy injects into every request
# it forwards to this origin; requests without it are rejected. Required,
# no default (same fail-loud posture as ADMIN_PASSWORD). Shape: the
# literal prefix "folio_edge_" followed by exactly 64 hex characters (32
# bytes / 256 bits). Generate your own before running anything:
#
#   EDGE_AUTH_TOKEN="folio_edge_$(openssl rand -hex 32)"
#
# The value below is DELIBERATELY invalid (wrong length, non-hex
# characters) so a copy-paste that skips this step panics at startup
# with the reason, instead of silently running on a value every clone
# of this public repo shares. Never replace it with another shared
# placeholder — generate a fresh one per environment.
EDGE_AUTH_TOKEN=folio_edge_REPLACE_WITH_YOUR_OWN_64_HEX_CHARACTERS

# Logging level (tracing — see https://docs.rs/tracing-subscriber/latest/tracing_subscriber/filter/struct.EnvFilter.html)
# RUST_LOG=info,site_core=debug
